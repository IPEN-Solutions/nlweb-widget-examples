# Copy to .env only when explicitly running this example.
# General opt-in for a configured custom extractor (including non-LLM extractors).
# When enabled, app startup runs extraction before source sync.
NLWEB_EXTERNAL_SOURCE_ENABLED=false
# Separate opt-in for LLM-backed extraction; backend choice below is required explicitly.
NLWEB_EXTERNAL_SOURCE_LLM_ENABLED=false
NLWEB_EXTERNAL_SOURCE_EXTRACTOR_BACKEND=scrapegraphai
# Example non-LLM alternative; install with `uv sync --extra external-beautifulsoup`.
# NLWEB_EXTERNAL_SOURCE_EXTRACTOR_FACTORY=examples.external_hosted_sources.domain_site_extractor.adapter:build_beautifulsoup_extractor
NLWEB_EXTERNAL_SOURCE_SCENARIO=company_website
NLWEB_EXTERNAL_SOURCE_SITE=https://external-source.example/

# Configure the hosted URL for the selected scenario; run the CLI once per scenario.
# Each scenario has its own corpus ID and exact generated artifact in sources.toml.
# Explicit extraction also requires an allowlist of hostnames.
# NLWEB_EXTERNAL_SOURCE_ALLOWED_HOSTS=your-company.example,help.your-company.example
# NLWEB_EXTERNAL_SOURCE_COMPANY_WEBSITE_URL=
# NLWEB_EXTERNAL_SOURCE_KNOWLEDGE_BASE_URL=
# NLWEB_EXTERNAL_SOURCE_PORTAL_URL=
# NLWEB_EXTERNAL_SOURCE_CATALOG_URL=
# NLWEB_EXTERNAL_SOURCE_NEWSROOM_URL=

# OpenRouter is the default LLM transport for this optional adapter.
# Override these to use another OpenAI-compatible provider or model.
NLWEB_EXTERNAL_SOURCE_LLM_PROVIDER=openrouter
NLWEB_EXTERNAL_SOURCE_LLM_MODEL=openai/gpt-4o-mini
NLWEB_EXTERNAL_SOURCE_LLM_BASE_URL=https://openrouter.ai/api/v1
# NLWEB_EXTERNAL_SOURCE_LLM_API_KEY=
# OPENROUTER_API_KEY=
NLWEB_EXTERNAL_SOURCE_LLM_TEMPERATURE=0
NLWEB_EXTERNAL_SOURCE_HEADLESS=true

# Explicit Widget enablement and source-sync lifecycle (same contract as provider examples).
# Set either flag false only when intentionally disabling projection or startup ingestion.
NLWEB_ENABLED=true
NLWEB_CONTENT_SYNC_ENABLED=true
NLWEB_CONTENT_SYNC_ON_STARTUP=true
NLWEB_CONTENT_SYNC_INTERVAL_SECONDS=0
NLWEB_CONTENT_SYNC_STATE_FILE=runtime/state/.nlweb-sync-state.json

# The retrieval database is the Widget's normal SQLite provider state.
NLWEB_RETRIEVAL_STORE=sqlite
NLWEB_SQLITE_PATH=./runtime/retrieval/nlweb.db
NLWEB_SQLITE_DIMENSIONS=384
NLWEB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLWEB_EMBEDDING_DEVICE=cpu
NLWEB_EMBEDDING_BATCH_SIZE=1
NLWEB_EMBEDDING_NORMALIZE=true

# This is deliberately a separate database from the Widget retrieval store.
NLWEB_EXTERNAL_SOURCE_EXTRACTION_DB=runtime/extracted-content.sqlite3
# Generated artifact path is defined per scenario in sources.toml and must not be overridden
# globally; this keeps every artifact bound to its one registry entry and corpus ID.

# Optional consumer-owned Widget source registry override (leave commented to use this example default).
# NLWEB_CONTENT_SOURCES_FILE=path/to/consumer-owned/nlweb-sources.json


# Optional local-first Scrapy + Ollama extraction (separate from ScrapeGraphAI).
NLWEB_LOCAL_OLLAMA_MODEL=qwen2.5:0.5b
NLWEB_LOCAL_OLLAMA_URL=http://127.0.0.1:11434/api/chat
NLWEB_LOCAL_OLLAMA_TIMEOUT_SECONDS=90

# Remote object storage (disabled until a registry source is enabled). Keep related settings together.
# Configure the bucket and optional prefix in nlweb-sources.json; prefix defaults to the bucket root.
# endpoint_url may be a bare hostname or an http(s) URL; use the provider's required scheme when known.
NLWEB_REMOTE_STORAGE_BUCKET=
NLWEB_REMOTE_STORAGE_ENDPOINT_URL=
NLWEB_REMOTE_STORAGE_ACCESS_KEY=
NLWEB_REMOTE_STORAGE_SECRET_KEY=
NLWEB_REMOTE_STORAGE_REGION=

# CouchDB document store (source disabled by default in nlweb-sources.json).
NLWEB_COUCHDB_URL=http://127.0.0.1:5984
NLWEB_COUCHDB_DATABASE=nlweb_domain
NLWEB_DOCUMENT_STORE_TIMEOUT_SECONDS=20
NLWEB_DOCUMENT_STORE_USERNAME=
NLWEB_DOCUMENT_STORE_PASSWORD=

# Explicit extractor backend selection; no backend is assumed by code when unset.
# scrapegraphai, scrapy_ollama, and scrapy_transformers require NLWEB_EXTERNAL_SOURCE_LLM_ENABLED=true.
# scrapy_transformers loads Qwen/Qwen2.5-0.5B-Instruct directly through Hugging Face Transformers.
# Resource-constrained local Transformers profile (dual-core CPU / 4 GB RAM).
# First model run downloads weights/tokenizer from Hugging Face; allow several GB disk space.
NLWEB_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
NLWEB_HF_DEVICE=cpu
NLWEB_HF_TORCH_THREADS=2
NLWEB_HF_MAX_NEW_TOKENS=96
NLWEB_HF_MAX_INPUT_TOKENS=1024
NLWEB_HF_MAX_PAGE_CHARS=2000
NLWEB_SCRAPY_MAX_PAGES=3
NLWEB_SCRAPY_DEPTH_LIMIT=1
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
# custom requires NLWEB_EXTERNAL_SOURCE_ENABLED=true and an extractor factory.
