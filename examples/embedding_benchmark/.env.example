# Operational overrides for the scenario-based local benchmark.
# Model/backend/revision/device/batch/prefix/top-k/threshold and source registry are
# selected by benchmark_scenarios.toml and nlweb-sources.json, not by this file.
# Do not add model-specific settings here; use .env.mteb for the separate MTEB runner.

# The current runner supports sqlite-vec only; other values fail fast.
NLWEB_BENCHMARK_RETRIEVAL_STORE=sqlite-vec

# Keep fixtures inside the benchmark-owned inbox unless a trusted registry source
# explicitly opts into an external path.
NLWEB_BENCHMARK_INBOX=inbox
NLWEB_BENCHMARK_RESULTS_DIR=benchmark_results

# Security gate: remote Ollama endpoints are denied unless explicitly opted in.
# Predefined scenarios use loopback. Set true only when intentionally using a trusted remote host.
NLWEB_BENCHMARK_ALLOW_REMOTE_OLLAMA=false
