# Optional settings for the separate MTEB public-task runner only.
# Copy to .env.mteb when you need to override its CLI/default configuration.
# The scenario-based local benchmark does not read these model settings.
NLWEB_BENCHMARK_EMBEDDING_BACKEND=sentence-transformers
NLWEB_BENCHMARK_EMBEDDING_MODEL=intfloat/multilingual-e5-small
NLWEB_BENCHMARK_OLLAMA_MODEL=qllama/multilingual-e5-small
NLWEB_BENCHMARK_OLLAMA_URL=http://127.0.0.1:11434
NLWEB_BENCHMARK_QUERY_PREFIX=query: 
NLWEB_BENCHMARK_DOCUMENT_PREFIX=passage: 
NLWEB_BENCHMARK_MTEB_RESULTS_DIR=mteb_results
