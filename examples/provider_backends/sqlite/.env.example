# Provider-specific runtime environment. Copy to .env in this directory.
NLWEB_RETRIEVAL_STORE=sqlite
NLWEB_CONTENT_SYNC_ENABLED=true
NLWEB_CONTENT_SYNC_ON_STARTUP=true
NLWEB_SQLITE_PATH=./.nlweb-sqlite/nlweb.db
NLWEB_SQLITE_DIMENSIONS=384
NLWEB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLWEB_EMBEDDING_DEVICE=cpu
NLWEB_EMBEDDING_BATCH_SIZE=1
NLWEB_EMBEDDING_NORMALIZE=true

# Sentence-transformers prefix controls; leave empty for MiniLM, set query:/passage: for E5.
NLWEB_EMBEDDING_QUERY_PREFIX=
NLWEB_EMBEDDING_DOCUMENT_PREFIX=

# Optional consumer-owned Widget source registry override (leave commented to use this example default).
# NLWEB_CONTENT_SOURCES_FILE=path/to/consumer-owned/nlweb-sources.json

# Remote object storage (disabled until a registry source is enabled). Keep related settings together.
# Configure the bucket and optional prefix in nlweb-sources.json; prefix defaults to the bucket root.
# endpoint_url may be a bare hostname or an http(s) URL; use the provider's required scheme when known.
NLWEB_REMOTE_STORAGE_BUCKET=
NLWEB_REMOTE_STORAGE_ENDPOINT_URL=
NLWEB_REMOTE_STORAGE_ACCESS_KEY=
NLWEB_REMOTE_STORAGE_SECRET_KEY=
NLWEB_REMOTE_STORAGE_REGION=

# CouchDB document store (source disabled by default in nlweb-sources.json).
NLWEB_COUCHDB_URL=http://127.0.0.1:5984
NLWEB_COUCHDB_DATABASE=nlweb_domain
NLWEB_DOCUMENT_STORE_TIMEOUT_SECONDS=20
NLWEB_DOCUMENT_STORE_USERNAME=
NLWEB_DOCUMENT_STORE_PASSWORD=

# Explicit extractor backend selection; no backend is assumed by code when unset.
# scrapegraphai and scrapy_ollama require NLWEB_EXTERNAL_SOURCE_LLM_ENABLED=true.
# custom requires NLWEB_EXTERNAL_SOURCE_ENABLED=true and an extractor factory.
NLWEB_EXTERNAL_SOURCE_EXTRACTOR_BACKEND=scrapegraphai
