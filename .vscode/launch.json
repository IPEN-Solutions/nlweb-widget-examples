{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI example",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "examples.fastapi_retail.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ]
    },
    {
      "name": "Python: Agent visibility demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/fastapi_retail/agent_demo.py"
    },
    {
      "name": "Python: Current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ]
    },
    {
      "name": "Python: AskAgent visibility test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
